NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Used to build invite links server-side; falls back to the request's
# host header if unset, but set this explicitly in production.
NEXT_PUBLIC_APP_URL=

# Signs user session cookies (fb_session). Generate with:
#   openssl rand -base64 32
SESSION_SECRET=

# Signs the admin session cookie (fb_admin_session) — deliberately a
# separate secret from SESSION_SECRET so a leaked user-session secret
# can never be used to forge admin access. Generate the same way.
ADMIN_SESSION_SECRET=

# bcrypt hash of the Master Admin PIN — never store the raw PIN.
# Generate with: node scripts/hash-pin.js <your-pin>
ADMIN_PIN_HASH=

# Google Gemini Pro API key for background job detail extraction.
# Get yours at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
